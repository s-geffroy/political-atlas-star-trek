{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "seo-audit/findings_schema.json",
  "title": "findings.json d'un audit /seo-audit",
  "description": "Forme du fichier. Les regles croisees (CONFIRME exige une preuve directe, P0 reserve a CONFIRME, revue humaine des actions a risque, references existantes, absence de secrets et de valeurs d'exemple) sont verifiees par validate_findings.py, qui fait foi.",
  "type": "object",
  "required": ["audited_url", "generated_at", "findings"],
  "properties": {
    "audited_url": {"type": "string"},
    "generated_at": {"type": "string"},
    "mode": {"enum": ["public", "source", "connected"]},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "category", "status", "evidence_level", "confidence", "priority",
                   "url_examples", "scope", "observation", "evidence", "impact_hypothesis",
                   "action", "implementation_location", "effort", "risk", "dependencies",
                   "owner_role", "verification", "review_status", "human_review_required"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEO-[0-9]{3,4}$"},
        "category": {"type": "string", "minLength": 1},
        "status": {"enum": ["CONFIRME", "SUSPECTE", "NON_VERIFIABLE", "REJETE"]},
        "evidence_level": {"enum": ["OBSERVE", "MESURE", "INFERE", "FOURNI_PAR_UTILISATEUR", "NON_VERIFIABLE"]},
        "confidence": {"enum": ["elevee", "moyenne", "faible"]},
        "priority": {"enum": ["P0", "P1", "P2", "P3", "INVESTIGUER"]},
        "url_examples": {"type": "array", "items": {"type": "string"}},
        "scope": {"enum": ["page", "template", "site", "inconnu"]},
        "observation": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
        "impact_hypothesis": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "implementation_location": {"type": "string", "minLength": 1},
        "effort": {"type": "string", "minLength": 1},
        "risk": {"type": "string", "minLength": 1},
        "dependencies": {"type": "array", "items": {"type": "string"}},
        "owner_role": {"enum": ["contenu", "developpeur", "SEO", "administrateur", "metier"]},
        "verification": {"type": "string", "minLength": 1},
        "review_status": {"enum": ["ACCEPTE", "A_VERIFIER", "REJETE", "RISQUE_MAJEUR"]},
        "human_review_required": {"type": "boolean"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source", "captured_at", "detail"],
      "properties": {
        "source": {"enum": ["HTTP", "HTML", "DOM", "robots", "sitemap", "CrUX", "Lighthouse",
                            "GSC", "analytics", "Git", "utilisateur", "autre"]},
        "captured_at": {"type": "string"},
        "detail": {"type": "string", "minLength": 1},
        "reference": {"type": "string"}
      }
    }
  }
}
